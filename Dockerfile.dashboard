FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-dex.txt constraints.txt ./
RUN pip install --no-cache-dir -c constraints.txt -r requirements.txt -r requirements-dex.txt

COPY TradingAgents/ ./TradingAgents/
RUN pip install --no-cache-dir -c constraints.txt -e ./TradingAgents \
    && pip check

COPY hybrid/ ./hybrid/

ENV PYTHONPATH=/app:/app/TradingAgents
# No TTY in a container: without this, print() output sits in a buffer and never reaches docker logs
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "hybrid.dashboard.app:app", "--host", "0.0.0.0", "--port", "8000"]
